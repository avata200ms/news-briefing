# Application Settings
APP_ENV=development
APP_NAME=news-briefing
DEBUG=True
LOG_LEVEL=INFO

# Django Settings
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-1234567890
ALLOWED_HOSTS=127.0.0.1,localhost

# Google Gemini API Settings
# https://aistudio.google.com/ 에서 발급받은 API 키를 입력하세요.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Naver Search API Settings
# https://developers.naver.com/apps/#/register 에서 애플리케이션 등록 후 키를 입력하세요.
# '검색' 서비스 선택
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
